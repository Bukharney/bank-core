# ==============================================================================
# Bank Core Engine - Production Environment Variables
# Copy to .env.prod on your Linux ARM host: cp .env.prod.example .env.prod
# ==============================================================================

# Container Images (GHCR)
# Replace 'bukharney' with your GitHub username or organization name if different
BACKEND_IMAGE=ghcr.io/bukharney/bank-core-backend:latest
ATM_IMAGE=ghcr.io/bukharney/bank-core-atm:latest
FRONTEND_IMAGE=ghcr.io/bukharney/bank-core-frontend:latest

# PostgreSQL Configuration
POSTGRES_USER=bankadmin
# Generate strong password: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=bank

# Redis Configuration
# Generate strong password: openssl rand -base64 24
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_DB=0

# JWT Security Secrets (CRITICAL: MUST BE SECURE AND RANDOM IN PRODUCTION)
# Generate via: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32_access_secret
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32_refresh_secret

# ATM Simulators (optional if running standalone ATM daemons)
ATM_VAULT_1_URL=http://localhost:8081
ATM_VAULT_2_URL=http://localhost:8082
ATM_VAULT_3_URL=http://localhost:8083
