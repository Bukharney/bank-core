      "id": 6,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (atm_id, status) (bank_atm_dispense_total)",
          "legendFormat": "ATM #{{atm_id}} ({{status}})",
          "refId": "A"
