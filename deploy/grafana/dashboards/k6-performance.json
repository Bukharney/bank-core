      "id": 6,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (type) (bank_ledger_transactions_total{status=\"success\"})",
          "legendFormat": "{{type}} Successes",
          "refId": "A"
        }
      ],
      "title": "Total Successful Transactions Committed",
