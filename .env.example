# ==============================================================================
# Bank Core Engine - Environment Configuration Template
# ==============================================================================

# Server
PORT=8080
SERVER_PORT=8080

# Database (PostgreSQL)
DB_URL=postgres://postgres:postgres@localhost:5432/bank?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bank
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Redis (Cache, Idempotency & Outbox)
REDIS_URL=localhost:6379
REDIS_PASSWORD=root
REDIS_DB=0

# JWT Secrets
JWT_ACCESS_SECRET=access
JWT_REFRESH_SECRET=refresh

# ATM Vault Client Endpoints
ATM_VAULT_1_URL=http://localhost:8081
ATM_VAULT_2_URL=http://localhost:8082
ATM_VAULT_3_URL=http://localhost:8083
