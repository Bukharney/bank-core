meta {
  name: Update Profile (PATCH)
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/user/profile
  body: json
  auth: none
}

headers {
  ~Cookie: access_token={{access_token}}
}

body:json {
  {
    "first_name": "Johnny",
    "last_name": "Doe",
    "phone_number": "0812345678"
  }
}

tests {
  test("should update user profile", function() {
    expect([200, 401]).to.include(res.getStatus());
  });
}
