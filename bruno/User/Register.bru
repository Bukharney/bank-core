meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{test_username}}",
    "email": "{{test_email}}",
    "phone_number": "{{test_phone}}",
    "password": "{{test_password}}",
    "first_name": "{{test_first_name}}",
    "last_name": "{{test_last_name}}"
  }
}

tests {
  test("should register user or return valid response", function() {
    expect([200, 201, 400, 409]).to.include(res.getStatus());
  });
}
