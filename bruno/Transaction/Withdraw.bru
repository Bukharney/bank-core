meta {
  name: Withdraw
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/transaction/withdraw
  body: json
  auth: none
}

headers {
  X-Idempotency-Key: {{idempotency_key}}
  ~Cookie: access_token={{access_token}}
}

body:json {
  {
    "account_id": {{account_id}},
    "amount": 50000,
    "currency": "THB",
    "atm_id": 1,
    "withdrawal_ref": "WDR-BRUNO-001",
    "description": "Withdrawal via Bruno"
  }
}

tests {
  test("should withdraw funds successfully", function() {
    expect([200, 201]).to.include(res.getStatus());
  });
}
