meta {
  name: 05 - Create Account B
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/account/create
  body: json
  auth: none
}

headers {
  ~Cookie: access_token={{access_token}}
}

body:json {
  {
    "account_type": "CHECKING",
    "currency": "THB"
  }
}

script:post-response {
  if (res.status === 201 && res.body) {
    bru.setVar("account_b_id", res.body.id);
    bru.setVar("account_b_number", res.body.account_number);
  }
}

tests {
  test("should create Account B", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a('number');
  });
}
